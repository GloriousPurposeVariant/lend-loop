# LendLoop settings: the only file you edit. Copy it to /.env, or better, run
#   npm run env:init
# which creates /.env with every secret generated. Then fill in the three Clerk values.
#
# Dev mode also needs services/core/.env.local and apps/web/.env.local:
# `npm run env:sync` writes both from /.env (see README > Getting started).

# Clerk dashboard -> Configure -> API keys. The issuer is the Frontend API URL.
CLERK_PUBLISHABLE_KEY=pk_test_replace-me
CLERK_SECRET_KEY=sk_test_replace-me
CLERK_JWT_ISSUER_DOMAIN=https://your-instance.clerk.accounts.dev
# Generated: 64 hex characters each.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONVEX_INSTANCE_NAME=lendloop-local
CONVEX_INSTANCE_SECRET=replace-with-64-hex-chars
N8N_ENCRYPTION_KEY=replace-with-64-hex-chars
N8N_OUTBOUND_SECRET=replace-with-64-hex-chars
N8N_INBOUND_SECRET=replace-with-64-hex-chars
AGENT_DB_PASSWORD=replace-with-64-hex-chars
# Development only: allows the sample-data commands. Never true in production.
LENDLOOP_ALLOW_SEED=true
# ---- LendLoop Assistant (optional; see agent/README.md) ----
# Default models as "provider:model". `npm run agent:local-model` or
# `npm run agent:models -- use ...` overrides them without editing this file.
# AGENT_MODEL=ollama:granite4:3b
# AGENT_FAST_MODEL=ollama:granite4:3b
# Only for the providers you use. Ollama (local) needs no key.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
