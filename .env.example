# Copy each block to the file named in its heading. Generate every secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ---- /.env  (read by docker compose) ----
CONVEX_INSTANCE_NAME=lendloop-local
CONVEX_INSTANCE_SECRET=replace-with-64-hex-chars
# Encrypts the credentials n8n stores.
N8N_ENCRYPTION_KEY=replace-with-64-hex-chars
# Convex signs its events to n8n with this; n8n verifies them.
N8N_OUTBOUND_SECRET=replace-with-64-hex-chars
# n8n signs its requests to Convex with this; Convex verifies them.
N8N_INBOUND_SECRET=replace-with-64-hex-chars

# ---- services/core/.env.local  (read by the Convex CLI) ----
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
# generate: npm run convex:admin-key
CONVEX_SELF_HOSTED_ADMIN_KEY=lendloop-local|replace-with-generated-key

# ---- apps/web/.env.local  (read by Next.js) ----
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
# Clerk dashboard -> Configure -> API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace-me
CLERK_SECRET_KEY=sk_test_replace-me

# ---- Convex deployment env (not a file). From services/core run: ----
# npx convex env set CLERK_JWT_ISSUER_DOMAIN https://your-instance.clerk.accounts.dev
# Development only: allows `npm run seed`. Never set this on production.
# npx convex env set LENDLOOP_ALLOW_SEED true
# n8n: the two secrets must be the same values as in /.env. Leave N8N_WEBHOOK_URL
# unset to record events without sending them.
# npx convex env set N8N_WEBHOOK_URL http://n8n:5678/webhook/lendloop-events
# npx convex env set N8N_OUTBOUND_SECRET <same as N8N_OUTBOUND_SECRET in /.env>
# npx convex env set N8N_INBOUND_SECRET <same as N8N_INBOUND_SECRET in /.env>
