.DS_Store
*.pem
*.tsbuildinfo
.vercel

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# clerk keyless mode stores temporary keys here
.clerk/

# python (agent service)
__pycache__/
.venv/
.pytest_cache/
.ruff_cache/

# MCP client config: holds personal tokens
mcp.json
